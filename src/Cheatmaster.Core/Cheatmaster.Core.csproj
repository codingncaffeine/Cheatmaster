<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Cheatmaster.Core</AssemblyName>
    <RootNamespace>Cheatmaster.Core</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Cheatmaster.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- DPAPI, for the GitHub token. Not in the base library on .NET Core. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
</Project>
