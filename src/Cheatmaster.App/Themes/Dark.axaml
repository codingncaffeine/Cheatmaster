<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- ============================ palette ============================ -->
        <!-- Neutral greys with a single warm accent, so status colour always reads as meaning. -->
        <Color x:Key="AppBackgroundColor">#FF17181B</Color>
        <Color x:Key="SurfaceColor">#FF1E2024</Color>
        <Color x:Key="SurfaceRaisedColor">#FF25272C</Color>
        <Color x:Key="SurfaceHoverColor">#FF2C2F35</Color>
        <Color x:Key="SurfaceActiveColor">#FF33373E</Color>
        <Color x:Key="BorderColor">#FF33363D</Color>
        <Color x:Key="BorderStrongColor">#FF454A53</Color>
        <Color x:Key="TextColor">#FFE7E9EC</Color>
        <Color x:Key="TextMutedColor">#FF9AA1AB</Color>
        <Color x:Key="TextFaintColor">#FF6B727C</Color>
        <Color x:Key="AccentColor">#FFE8A33D</Color>
        <Color x:Key="AccentHoverColor">#FFF2B458</Color>
        <Color x:Key="AccentPressedColor">#FFCC8B29</Color>
        <Color x:Key="SuccessColor">#FF5FA88E</Color>
        <Color x:Key="DangerColor">#FFD0574C</Color>
        <Color x:Key="InfoColor">#FF4FA6E8</Color>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
        <SolidColorBrush x:Key="SurfaceActiveBrush" Color="{StaticResource SurfaceActiveColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
        <SolidColorBrush x:Key="BorderHoverBrush" Color="#FF565C66" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
        <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
        <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
        <SolidColorBrush x:Key="AccentDimBrush" Color="#33E8A33D" />
        <SolidColorBrush x:Key="SelectionBrush" Color="#3DE8A33D" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FF16171A" />

        <!-- Segoe UI where Windows has it; Inter (shipped with the app) everywhere else. -->
        <FontFamily x:Key="UiFont">Segoe UI, fonts:Inter#Inter</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, JetBrains Mono, DejaVu Sans Mono, Liberation Mono, Noto Sans Mono, monospace</FontFamily>

        <!-- ============================ icons ============================ -->
        <!-- Drawn rather than taken from an icon font, which only Windows has. 10x10 boxes. -->
        <StreamGeometry x:Key="IconMinimize">M0,5 L10,5</StreamGeometry>
        <StreamGeometry x:Key="IconMaximize">M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconClose">M0,0 L10,10 M10,0 L0,10</StreamGeometry>
        <StreamGeometry x:Key="IconPin">M3.5,0.5 L6.5,0.5 L6.5,4 L8.5,6 L1.5,6 L3.5,4 Z M5,6 L5,10</StreamGeometry>
        <StreamGeometry x:Key="IconFilter">M0,1 L10,1 L6,5.5 L6,9.5 L4,8.5 L4,5.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconUp">M1,7 L5,3 L9,7</StreamGeometry>
        <StreamGeometry x:Key="IconDown">M1,3 L5,7 L9,3</StreamGeometry>

        <!-- ============================ Fluent, recoloured ============================ -->
        <Color x:Key="SystemAccentColor">#FFE8A33D</Color>
        <Color x:Key="SystemAccentColorDark1">#FFCC8B29</Color>
        <Color x:Key="SystemAccentColorDark2">#FFB0761F</Color>
        <Color x:Key="SystemAccentColorDark3">#FF8F5E16</Color>
        <Color x:Key="SystemAccentColorLight1">#FFF2B458</Color>
        <Color x:Key="SystemAccentColorLight2">#FFF5C47A</Color>
        <Color x:Key="SystemAccentColorLight3">#FFF8D49C</Color>

        <SolidColorBrush x:Key="TextControlBackground" Color="#FF16171A" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF16171A" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF16171A" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#FF16171A" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource BorderStrongColor}" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF565C66" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource TextFaintColor}" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource TextFaintColor}" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource TextFaintColor}" />
        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#66E8A33D" />
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

        <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource SurfaceRaisedColor}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource SurfaceHoverColor}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource SurfaceActiveColor}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource SurfaceRaisedColor}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{StaticResource SurfaceRaisedColor}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource BorderStrongColor}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FF565C66" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#FF565C66" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource SurfaceRaisedColor}" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource BorderStrongColor}" />
        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource TextMutedColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource SurfaceHoverColor}" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#33E8A33D" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#44E8A33D" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="{StaticResource AccentColor}" />

        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#FF16171A" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#FF16171A" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{StaticResource BorderStrongColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{StaticResource AccentHoverColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FF17181B" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FF17181B" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FF17181B" />

        <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource SurfaceRaisedColor}" />
        <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource BorderStrongColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource SurfaceHoverColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource SurfaceActiveColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="{StaticResource TextFaintColor}" />
        <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="{StaticResource TextFaintColor}" />

        <SolidColorBrush x:Key="ToolTipBackground" Color="#FF2A2D33" />
        <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource BorderStrongColor}" />
        <SolidColorBrush x:Key="ToolTipForeground" Color="{StaticResource TextColor}" />

        <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#FF3E434B" />
        <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#FF565C66" />
        <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{StaticResource AccentColor}" />

        <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="DataGridColumnHeaderHoveredBackgroundBrush" Color="{StaticResource SurfaceRaisedColor}" />
        <SolidColorBrush x:Key="DataGridColumnHeaderPressedBackgroundBrush" Color="{StaticResource SurfaceActiveColor}" />
        <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="{StaticResource TextFaintColor}" />
        <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="Transparent" />
        <SolidColorBrush x:Key="DataGridCellBackgroundBrush" Color="Transparent" />
        <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="{StaticResource BorderColor}" />
        <Color x:Key="DataGridRowHoveredBackgroundColor">#FF23252A</Color>
        <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="{StaticResource AccentColor}" />
        <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">0.24</x:Double>
        <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">0.18</x:Double>
        <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">0.3</x:Double>
        <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">0.24</x:Double>
        <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent" />
        <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent" />
        <SolidColorBrush x:Key="DataGridCurrencyVisualPrimaryBrush" Color="Transparent" />
    </Styles.Resources>

    <!-- ============================ windows ============================ -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- ============================ text ============================ -->
    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.faint">
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ============================ buttons ============================ -->
    <Style Selector="Button">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceActiveBrush}" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Foreground" Value="#FF17181B" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <!-- Title-bar buttons: flat, full height, no border. -->
    <Style Selector="Button.caption">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.caption:pointerover">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.close:pointerover">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FFC4453C" />
    </Style>

    <!-- Outline icons drawn with a pen, coloured by the button they sit in. -->
    <Style Selector="Path.glyph">
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
        <Setter Property="StrokeThickness" Value="1.2" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================ toggles ============================ -->
    <Style Selector="ToggleButton.segment">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter" Background="Transparent" CornerRadius="3"
                                  Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.segment:checked">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceActiveBrush}" />
    </Style>

    <!-- ============================ text input ============================ -->
    <Style Selector="TextBox">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="#66E8A33D" />
        <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>

    <!-- ============================ combo box ============================ -->
    <Style Selector="ComboBox">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ComboBox:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="9,6" />
    </Style>

    <!-- ============================ check box ============================ -->
    <Style Selector="CheckBox">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="7,0,0,0" />
    </Style>

    <!-- ============================ data grid ============================ -->
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserSortColumns" Value="False" />
        <Setter Property="ColumnHeaderHeight" Value="30" />
        <Setter Property="RowHeight" Value="26" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="DataGridCell TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================ list box ============================ -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceActiveBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SurfaceActiveBrush}" />
    </Style>

    <!-- ============================ progress ============================ -->
    <Style Selector="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="Background" Value="#FF2A2D33" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ============================ menus and tips ============================ -->
    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="MenuItem:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Separator">
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        <Setter Property="Margin" Value="6,4" />
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MaxWidth" Value="380" />
    </Style>

    <!-- ============================ tabs ============================ -->
    <Style Selector="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="13,7" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TabItem:pointerover">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- ============================ expander ============================ -->
    <!-- A plain arrow and a header, opening in place: no box around it. -->
    <Style Selector="Expander">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel>
                    <ToggleButton Name="PART_ToggleButton" Classes="expander-header" Focusable="False"
                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  Content="{TemplateBinding Header}" />
                    <ContentPresenter Name="PART_ContentPresenter" Margin="0,4,0,0"
                                      IsVisible="{TemplateBinding IsExpanded}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.expander-header">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" Padding="0,5" CornerRadius="3">
                    <StackPanel Orientation="Horizontal">
                        <Path Name="Arrow" Data="M0,0 L4,4 L0,8" Stroke="{StaticResource TextMutedBrush}"
                              StrokeThickness="1.4" VerticalAlignment="Center" Margin="2,0,8,0" />
                        <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.expander-header:checked /template/ Path#Arrow">
        <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
    <Style Selector="ToggleButton.expander-header:pointerover /template/ Path#Arrow">
        <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- ============================ shared shapes ============================ -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MinWidth" Value="1" />
        <Setter Property="MinHeight" Value="1" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <Rectangle Name="Line" Fill="{TemplateBinding Background}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="GridSplitter:pointerover /template/ Rectangle#Line">
        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- Memory view cells: the selected byte, and the ones that moved since the last read. -->
    <Style Selector="Border.cell.selected">
        <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
    </Style>
    <Style Selector="TextBlock.byte">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.byte.changed">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A saved cheat in the library: outlined green while any of it is held. -->
    <Style Selector="Border.saved-group">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style Selector="Border.saved-group.frozen">
        <Setter Property="BorderBrush" Value="#555FA88E" />
    </Style>
    <Style Selector="ListBox.games ListBoxItem">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Margin" Value="2" />
    </Style>

    <!-- Storage-theory chips: the best guess in amber, a pinned one in green, a capped one faded. -->
    <Style Selector="Border.chip">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    </Style>
    <Style Selector="Border.chip.best">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="#1FE8A33D" />
    </Style>
    <Style Selector="Border.chip.pinned">
        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
        <Setter Property="Background" Value="#1F5FA88E" />
    </Style>
    <Style Selector="Border.chip.capped">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- The results list: flat ruled rows, like a data grid's. -->
    <Style Selector="ListBox.results ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="ListBox.results ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox.results ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FF23252A" />
    </Style>
    <Style Selector="ListBox.results ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
    </Style>
    <Style Selector="Grid.results-header TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Grid cells that change colour with their row. -->
    <Style Selector="TextBlock.live.changed">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.unresolved">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>
    <Style Selector="TextBlock.unchecked">
        <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
    </Style>

    <!-- A status dot: grey until its "on" class is set. -->
    <Style Selector="Ellipse.status">
        <Setter Property="Fill" Value="{StaticResource TextFaintBrush}" />
    </Style>
    <Style Selector="Ellipse.status.on">
        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
    </Style>

    <!-- A notice: colour carries the meaning, set by class. -->
    <Style Selector="Border.notice">
        <Setter Property="Background" Value="#1A4FA6E8" />
    </Style>
    <Style Selector="Border.notice.success">
        <Setter Property="Background" Value="#1A5FA88E" />
    </Style>
    <Style Selector="Border.notice.warning">
        <Setter Property="Background" Value="#1AE8A33D" />
    </Style>
    <Style Selector="Border.notice.error">
        <Setter Property="Background" Value="#22D0574C" />
    </Style>
    <Style Selector="Border.notice TextBlock.notice-text">
        <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
    </Style>
    <Style Selector="Border.notice.success TextBlock.notice-text">
        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
    </Style>
    <Style Selector="Border.notice.warning TextBlock.notice-text">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Border.notice.error TextBlock.notice-text">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>
</Styles>
