<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cheatmaster.App.ViewModels"
        xmlns:views="using:Cheatmaster.App.Views"
        xmlns:inf="using:Cheatmaster.App.Infrastructure"
        x:Class="Cheatmaster.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Cheatmaster"
        Icon="/Assets/logo.png"
        Height="900" Width="1440" MinHeight="620" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None">

    <Window.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding ScanCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewScanCommand}" />
        <KeyBinding Gesture="Alt+Left" Command="{Binding UndoScanCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveTableCommand}" />
        <KeyBinding Gesture="Ctrl+P" Command="{Binding AttachCommand}" />
    </Window.KeyBindings>

    <Panel>
        <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
            <Grid RowDefinitions="34,Auto,Auto,*,24">

                <!-- ==================== title bar ==================== -->
                <Grid Name="TitleBar" Grid.Row="0" Background="{StaticResource SurfaceBrush}" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="18" Height="18"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock Text="Cheatmaster" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GameName}" Margin="12,0,0,0" FontSize="11.5"
                                   Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center"
                                   IsVisible="{Binding GameName, Converter={x:Static inf:NotEmpty.Instance}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Classes="caption" Click="OnMinimize" ToolTip.Tip="Minimise">
                            <Path Classes="glyph" Data="{StaticResource IconMinimize}" />
                        </Button>
                        <Button Classes="caption" Click="OnMaximize" ToolTip.Tip="Maximise">
                            <Path Classes="glyph" Data="{StaticResource IconMaximize}" />
                        </Button>
                        <Button Classes="caption close" Click="OnClose" ToolTip.Tip="Close">
                            <Path Classes="glyph" Data="{StaticResource IconClose}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ==================== target bar ==================== -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,1" Padding="12,9">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <Border Grid.Column="0" Margin="0,0,12,0" CornerRadius="5" Padding="2"
                                Background="#FF16171A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Content="Scanner" Classes="segment"
                                              IsChecked="{Binding IsScannerView, Mode=OneWay}"
                                              Command="{Binding ShowScannerCommand}" />
                                <ToggleButton Content="Library" Classes="segment"
                                              IsChecked="{Binding IsLibraryView, Mode=OneWay}"
                                              Command="{Binding ShowLibraryCommand}" />
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="1" Command="{Binding AttachCommand}" Padding="10,6" MinWidth="260"
                                HorizontalContentAlignment="Left" ToolTip.Tip="Choose the process to work on  (Ctrl+P)">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="2,0,10,0"
                                         Classes="status" Classes.on="{Binding IsAttached}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding ProcessTitle}" FontWeight="SemiBold" FontSize="12.5" />
                                    <TextBlock Text="{Binding ProcessSubtitle}" FontSize="11"
                                               Foreground="{StaticResource TextFaintBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Border Background="#22D0574C" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="9,4" Margin="0,0,10,0" VerticalAlignment="Center"
                                    IsVisible="{Binding ShowElevationHint}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ElevationHintText}" FontSize="11.5"
                                               Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                                    <Button Content="{Binding ElevationActionLabel}" Command="{Binding RestartElevatedCommand}"
                                            Classes="icon" Margin="10,0,0,0" FontSize="11.5"
                                            FontFamily="{StaticResource UiFont}"
                                            Foreground="{StaticResource DangerBrush}"
                                            ToolTip.Tip="{Binding ElevationActionTip}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding FreezeStatus}" VerticalAlignment="Center" Margin="0,0,12,0"
                                       FontSize="11.5" Foreground="{StaticResource SuccessBrush}"
                                       IsVisible="{Binding FreezeStatus, Converter={x:Static inf:NotEmpty.Instance}}" />

                            <Button Content="Guide" Command="{Binding ShowGuideCommand}" Margin="0,0,8,0"
                                    ToolTip.Tip="Walk through a whole search, one step at a time" />
                            <Button Content="Detach" Command="{Binding DetachCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== notice ==================== -->
                <Border Grid.Row="2" Padding="14,7" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}"
                        Classes="notice"
                        Classes.success="{Binding NoticeLevel, Converter={x:Static inf:EqualsConverter.Instance}, ConverterParameter={x:Static vm:NoticeKind.Success}}"
                        Classes.warning="{Binding NoticeLevel, Converter={x:Static inf:EqualsConverter.Instance}, ConverterParameter={x:Static vm:NoticeKind.Warning}}"
                        Classes.error="{Binding NoticeLevel, Converter={x:Static inf:EqualsConverter.Instance}, ConverterParameter={x:Static vm:NoticeKind.Error}}"
                        IsVisible="{Binding Notice, Converter={x:Static inf:NotEmpty.Instance}}">
                    <Grid>
                        <SelectableTextBlock Text="{Binding Notice}" TextWrapping="Wrap" Margin="0,0,26,0" FontSize="12"
                                             Classes="notice-text" />
                        <Button Classes="caption" Width="24" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="OnDismissNotice" ToolTip.Tip="Dismiss">
                            <Path Classes="glyph" Data="{StaticResource IconClose}" Width="8" Height="8" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <!-- ==================== body ==================== -->
                <Grid Grid.Row="3" ColumnDefinitions="310,5,*" IsVisible="{Binding IsScannerView}">

                    <!-- scan panel -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" MinWidth="270"
                            IsVisible="{Binding !Guide.IsActive}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,14,10,14">
                            <StackPanel>
                                <TextBlock Text="SEARCH FOR" Classes="section" />

                                <TextBox Name="ValueBox" Classes="mono" FontSize="16" Padding="10,8"
                                         PlaceholderText="{Binding ValuePlaceholder}"
                                         Text="{Binding ValueText}" KeyDown="OnValueKeyDown"
                                         IsEnabled="{Binding NeedsValue}" />

                                <TextBox Classes="mono" FontSize="14" Margin="0,7,0,0" Padding="10,7"
                                         PlaceholderText="{Binding Value2Placeholder}"
                                         Text="{Binding Value2Text}" KeyDown="OnValueKeyDown"
                                         IsVisible="{Binding NeedsSecondValue}" />

                                <ComboBox Margin="0,7,0,0" ItemsSource="{Binding CompareOptions}"
                                          SelectedItem="{Binding SelectedCompare}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CompareOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Snapshot step, shown only for the searches that need one. -->
                                <Border Margin="0,10,0,0" Padding="11,10" CornerRadius="5"
                                        Background="#1A4FA6E8" BorderBrush="{StaticResource InfoBrush}" BorderThickness="1"
                                        IsVisible="{Binding NeedsSnapshot}">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" LineHeight="16"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="This search compares memory against a copy taken earlier. Capture now, change the value in the game, then scan." />

                                        <Button Content="Capture memory now" Command="{Binding CaptureCommand}"
                                                Margin="0,9,0,0" HorizontalAlignment="Stretch" />

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsVisible="{Binding HasSnapshot}">
                                            <TextBlock Text="{Binding SnapshotStatus}" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource SuccessBrush}" />
                                            <Button Content="discard" Command="{Binding ClearSnapshotCommand}"
                                                    Margin="8,0,0,0" Classes="icon"
                                                    FontFamily="{StaticResource UiFont}" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="STORED AS" Classes="section" Margin="0,16,0,6" />
                                <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedTypeOption}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TypeOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Margin="1,6,0,0" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource TextFaintBrush}" IsVisible="{Binding IsAutoType}"
                                           Text="Every plausible encoding is tested at once — whole numbers, floats, percentages and scaled values — and the ones that match are reported below." />

                                <Button Classes="primary" Margin="0,16,0,0" Height="40" HorizontalAlignment="Stretch"
                                        FontSize="13.5" Content="{Binding ScanButtonLabel}"
                                        Command="{Binding ScanCommand}" ToolTip.Tip="Search memory  (F5)" />

                                <Grid Margin="0,7,0,0" ColumnDefinitions="*,6,*">
                                    <Button Grid.Column="0" Content="Undo" Command="{Binding UndoScanCommand}"
                                            HorizontalAlignment="Stretch" ToolTip.Tip="Go back one scan  (Alt+Left)" />
                                    <Button Grid.Column="2" Content="New search" Command="{Binding NewScanCommand}"
                                            HorizontalAlignment="Stretch" ToolTip.Tip="Throw away these results  (Ctrl+N)" />
                                </Grid>

                                <StackPanel Margin="0,10,0,0" IsVisible="{Binding IsScanning}">
                                    <ProgressBar Value="{Binding ScanProgress, Mode=OneWay}" Maximum="100" />
                                    <TextBlock Text="{Binding ScanPhase}" FontSize="11" Margin="0,6,0,0"
                                               Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                    <Button Content="Cancel" Command="{Binding CancelScanCommand}" Margin="0,7,0,0"
                                            Classes="danger" HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,10" />

                                <Expander Header="Scan options">
                                    <StackPanel Margin="2,4,0,0">
                                        <TextBlock Text="HOW HARD TO LOOK" Classes="section" Margin="0,4,0,6" />
                                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ProfileOption">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                                   Foreground="{StaticResource TextFaintBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Text="DISPLAY ACCURACY" Classes="section" Margin="0,14,0,6" />
                                        <ComboBox ItemsSource="{Binding RoundingModes}" SelectedItem="{Binding SelectedRounding}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RoundingOption">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                                   Foreground="{StaticResource TextFaintBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Text="ADDRESS STEP" Classes="section" Margin="0,14,0,6" />
                                        <ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding SelectedAlignment}"
                                                  ToolTip.Tip="4 is the usual compromise. 1 finds values packed at odd offsets, and is slower." />

                                        <TextBlock Text="WHERE TO LOOK" Classes="section" Margin="0,14,0,6" />
                                        <CheckBox Content="Writable memory only" IsChecked="{Binding WritableOnly}" Margin="0,3" />
                                        <CheckBox Content="Include module memory" IsChecked="{Binding IncludeImage}" Margin="0,3" />
                                        <CheckBox Content="Include heap memory" IsChecked="{Binding IncludePrivate}" Margin="0,3" />
                                        <CheckBox Content="Include mapped memory" IsChecked="{Binding IncludeMapped}" Margin="0,3"
                                                  ToolTip.Tip="Some engines keep game state in mapped views. Leaving this on is why a value another tool cannot see may turn up here." />

                                        <TextBlock Text="BEHAVIOUR" Classes="section" Margin="0,14,0,6" />
                                        <CheckBox Content="Keep values live" IsChecked="{Binding LiveValues}" Margin="0,3" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- guided walkthrough, in place of the scan panel until it is dismissed -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" IsVisible="{Binding Guide.IsActive}">
                        <Grid RowDefinitions="*,Auto">
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="14,14,10,14">
                                <StackPanel>
                                    <TextBlock Text="GETTING STARTED" Classes="section" />

                                    <TextBlock Text="{Binding Guide.Title}" FontSize="15.5" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,10,0,0" />

                                    <TextBlock Text="{Binding Guide.Body}" TextWrapping="Wrap" LineHeight="19"
                                               Margin="0,8,0,0" Foreground="{StaticResource TextMutedBrush}" />

                                    <TextBox Margin="0,14,0,0" Padding="10,8" FontSize="14"
                                             PlaceholderText="health, money, ammo…"
                                             Text="{Binding Guide.Subject}"
                                             IsVisible="{Binding Guide.ShowSubjectBox}" />

                                    <TextBox Margin="0,14,0,0" Padding="10,8" FontSize="16" Classes="mono"
                                             PlaceholderText="{Binding ValuePlaceholder}"
                                             Text="{Binding ValueText}" KeyDown="OnGuideValueKeyDown"
                                             IsVisible="{Binding Guide.ShowValueBox}" />

                                    <ItemsControl ItemsSource="{Binding Guide.Choices}" Margin="0,14,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GuideChoice">
                                                <Button Command="{Binding Command}" Margin="0,0,0,8" Padding="12,10"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                                                        <TextBlock Text="{Binding Hint}" FontSize="11" Margin="0,3,0,0"
                                                                   TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="{Binding Guide.PrimaryLabel}" Command="{Binding Guide.PrimaryCommand}"
                                            Classes="primary" Margin="0,14,0,0" Padding="12,9" HorizontalAlignment="Stretch"
                                            IsVisible="{Binding Guide.HasPrimary}" />

                                    <ProgressBar Margin="0,12,0,0" Maximum="100" Value="{Binding ScanProgress, Mode=OneWay}"
                                                 IsVisible="{Binding IsScanning}" />

                                    <TextBlock Text="{Binding Guide.ProgressText}" Margin="0,12,0,0" FontSize="11.5"
                                               TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}"
                                               IsVisible="{Binding Guide.ProgressText, Converter={x:Static inf:NotEmpty.Instance}}" />
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                                <Button Content="Skip the guide" Command="{Binding Guide.DismissCommand}" HorizontalAlignment="Left"
                                        ToolTip.Tip="Go back to the full search panel. The Guide button in the bar brings this back." />
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                    <!-- results and table -->
                    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,5,260" MinWidth="520">

                        <!-- verdict -->
                        <Border Grid.Row="0" Margin="12,12,12,0" Padding="14,11" Classes="card"
                                IsVisible="{Binding Verdict, Converter={x:Static inf:NotEmpty.Instance}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Verdict}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding ResultCountText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                               FontSize="11.5" Foreground="{StaticResource TextFaintBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding VerdictDetail}" TextWrapping="Wrap" Margin="0,5,0,0"
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                <!-- Once few enough are left, the most likely one is offered outright. -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Spacing="12" IsVisible="{Binding HasLikely}">
                                    <Button Content="Find the real one" Classes="primary" Command="{Binding FindRealCommand}"
                                            IsVisible="{Binding CanFindReal}"
                                            ToolTip.Tip="Gives each address a slightly different number. Open the game screen that shows it, and the address whose number spreads to the others is the real one." />
                                    <TextBlock Text="Open the game screen that shows this number…" VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentBrush}" IsVisible="{Binding IsFindingReal}" />
                                    <Button Content="Add and test it" Command="{Binding AddAndTestCommand}" IsVisible="{Binding !IsFindingReal}"
                                            ToolTip.Tip="Add the most likely address and write a new value to it. If the game's number changes, that is the one." />
                                    <TextBlock Text="{Binding LikelyText}" VerticalAlignment="Center" Classes="mono"
                                               Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- storage-theory chips -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Chips}" Margin="12,10,12,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InterpretationChip">
                                    <Border Margin="0,0,7,7" CornerRadius="12" BorderThickness="1"
                                            ToolTip.Tip="{Binding ToolTipText}"
                                            Classes="chip" Classes.best="{Binding IsBest}"
                                            Classes.pinned="{Binding IsPinned}" Classes.capped="{Binding Capped}">
                                        <StackPanel Orientation="Horizontal" Margin="10,4,6,4">
                                            <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center" />
                                            <Border Background="#33000000" CornerRadius="7" Padding="6,1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding CountText}" FontSize="10.5"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                            <Button Classes="icon" Margin="4,0,0,0" Padding="4,2" MinHeight="20" MinWidth="20"
                                                    ToolTip.Tip="Only consider this encoding from now on"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PinInterpretationCommand}"
                                                    CommandParameter="{Binding}">
                                                <Path Classes="glyph" Data="{StaticResource IconPin}" />
                                            </Button>
                                            <Button Classes="icon" Padding="4,2" MinHeight="20" MinWidth="20"
                                                    ToolTip.Tip="Throw away every other encoding right now"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).KeepOnlyCommand}"
                                                    CommandParameter="{Binding}">
                                                <Path Classes="glyph" Data="{StaticResource IconFilter}" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- results -->
                        <Border Grid.Row="2" Margin="12,10,12,0" Classes="card" ClipToBounds="True" MinHeight="140">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" Margin="12,9,10,7">
                                    <TextBlock Text="RESULTS" Classes="section" Margin="0" VerticalAlignment="Center" />
                                    <Button Content="Add selected to table" HorizontalAlignment="Right"
                                            Padding="10,4" MinHeight="26" FontSize="11.5"
                                            Command="{Binding AddSelectedCommand}"
                                            CommandParameter="{Binding #ResultsGrid.SelectedItems}" />
                                </Grid>

                                <!-- A list rather than a data grid: a grid copies its whole source up front, and a first
                                     scan can return a million addresses. This one only builds the rows on screen. -->
                                <Grid Grid.Row="1" RowDefinitions="30,*">
                                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
                                        <Grid ColumnDefinitions="150,130,130,*" Classes="results-header">
                                            <TextBlock Grid.Column="0" Text="Address" Margin="12,0,0,0" />
                                            <TextBlock Grid.Column="1" Text="Value now" Margin="10,0,0,0" />
                                            <TextBlock Grid.Column="2" Text="When found" Margin="10,0,0,0" />
                                            <TextBlock Grid.Column="3" Text="Stored as" Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>
                                    <ListBox Name="ResultsGrid" Grid.Row="1" Classes="results" ItemsSource="{Binding Results}"
                                             SelectionMode="Multiple" DoubleTapped="OnResultDoubleClick">
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Add to cheat table" InputGesture="Enter"
                                                          Command="{Binding AddSelectedCommand}"
                                                          CommandParameter="{Binding #ResultsGrid.SelectedItems}" />
                                                <Separator />
                                                <MenuItem Header="See what touches this…" Click="OnWatchResult"
                                                          ToolTip.Tip="Wait for the game to touch this address, and see which code did" />
                                                <MenuItem Header="Show in memory…" Click="OnShowResultInMemory"
                                                          ToolTip.Tip="Look at the bytes around this address, and what else is in the same object" />
                                                <Separator />
                                                <MenuItem Header="Copy address" Click="OnCopyAddress" />
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ResultRow">
                                                <Grid ColumnDefinitions="150,130,130,*" Height="26">
                                                    <TextBlock Grid.Column="0" Text="{Binding AddressText}" Classes="mono" Margin="12,0,0,0"
                                                               VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                               Classes="mono live" Classes.changed="{Binding Changed}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding FoundText}" Classes="mono" Margin="10,0,0,0"
                                                               VerticalAlignment="Center" Foreground="{StaticResource TextFaintBrush}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding TypeLabel}" Margin="10,0,0,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            IsVisible="{Binding !HasResults}">
                                    <TextBlock Text="No results yet" HorizontalAlignment="Center" FontSize="13"
                                               Foreground="{StaticResource TextFaintBrush}" />
                                    <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="11.5" MaxWidth="420"
                                               TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}"
                                               Text="Type a number you can see in the game and press First scan. You do not need to know how the game stores it." />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Row="3" ResizeDirection="Rows" />

                        <!-- cheat table -->
                        <Border Grid.Row="4" Margin="12,0,12,12" Classes="card" ClipToBounds="True" MinHeight="120">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" Margin="12,9,10,7">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="CHEAT TABLE" Classes="section" Margin="0" />
                                        <TextBlock Text="{Binding GameName}" Margin="10,0,0,0" FontSize="11"
                                                   Foreground="{StaticResource TextFaintBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                        <CheckBox Content="Freeze all" IsChecked="{Binding FreezeAll}"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                                  ToolTip.Tip="Hold every value in this table where it is" />
                                        <Button Content="Re-check routes" Padding="10,4" MinHeight="26" FontSize="11.5"
                                                Command="{Binding RecheckRoutesCommand}" IsVisible="{Binding HasRoutes}"
                                                ToolTip.Tip="Follow every saved route again. A route only proves itself after the game has restarted." />
                                        <Button Content="Set value…" Padding="10,4" MinHeight="26" FontSize="11.5"
                                                Command="{Binding SetValueCommand}"
                                                CommandParameter="{Binding #CheatsGrid.SelectedItems}"
                                                ToolTip.Tip="Write one value into every selected entry" />
                                        <Button Content="Freeze" Padding="10,4" MinHeight="26" FontSize="11.5"
                                                Command="{Binding FreezeSelectedCommand}"
                                                CommandParameter="{Binding #CheatsGrid.SelectedItems}"
                                                ToolTip.Tip="Hold the selected values where they are" />
                                        <Button Content="Remove" Padding="10,4" MinHeight="26" FontSize="11.5"
                                                Command="{Binding RemoveCheatCommand}"
                                                CommandParameter="{Binding #CheatsGrid.SelectedItems}" />
                                        <Button Content="Save" Padding="10,4" MinHeight="26" FontSize="11.5"
                                                Command="{Binding SaveTableCommand}"
                                                ToolTip.Tip="Save this game's cheats to your library  (Ctrl+S)" />
                                        <Button Content="Export" Padding="10,4" MinHeight="26" FontSize="11.5"
                                                Command="{Binding ExportTableCommand}" />
                                        <Button Content="Import" Padding="10,4" MinHeight="26" FontSize="11.5"
                                                Command="{Binding ImportTableCommand}" />
                                    </StackPanel>
                                </Grid>

                                <DataGrid Name="CheatsGrid" Grid.Row="1" ItemsSource="{Binding Cheats}"
                                          SelectionMode="Extended" IsReadOnly="False">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Set value…" Command="{Binding SetValueCommand}"
                                                      CommandParameter="{Binding #CheatsGrid.SelectedItems}" />
                                            <MenuItem Header="Freeze at value…" Command="{Binding FreezeAtValueCommand}"
                                                      CommandParameter="{Binding #CheatsGrid.SelectedItems}" />
                                            <MenuItem Header="See what touches this…" Click="OnWatchCheat"
                                                      ToolTip.Tip="Wait for the game to touch this address, and see which code did" />
                                            <MenuItem Header="Show in memory…" Click="OnShowCheatInMemory"
                                                      ToolTip.Tip="Look at the bytes around this address, and what else is in the same object" />
                                            <MenuItem Header="Find a stable address…" Click="OnFindPointerPath"
                                                      ToolTip.Tip="Trace a route that still finds this value after a restart" />
                                            <Separator />
                                            <MenuItem Header="Name this cheat…" Command="{Binding GroupSelectedCommand}"
                                                      CommandParameter="{Binding #CheatsGrid.SelectedItems}" />
                                            <MenuItem Header="Freeze / release" Command="{Binding FreezeSelectedCommand}"
                                                      CommandParameter="{Binding #CheatsGrid.SelectedItems}" />
                                            <Separator />
                                            <MenuItem Header="Select all" InputGesture="Ctrl+A" Click="OnSelectAllCheats" />
                                            <MenuItem Header="Copy address" Click="OnCopyCheatAddress" />
                                            <Separator />
                                            <MenuItem Header="Remove" Command="{Binding RemoveCheatCommand}"
                                                      CommandParameter="{Binding #CheatsGrid.SelectedItems}" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Freeze" Width="84" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:CheatRow">
                                                    <CheckBox IsChecked="{Binding Frozen}" HorizontalAlignment="Center" Padding="0"
                                                              ToolTip.Tip="Keep rewriting this value" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Cheat" Width="150" Binding="{Binding Group}"
                                                            Foreground="{StaticResource AccentBrush}" x:DataType="vm:CheatRow" />
                                        <DataGridTextColumn Header="Description" Width="*" Binding="{Binding Description}"
                                                            x:DataType="vm:CheatRow" />
                                        <DataGridTemplateColumn Header="Address" Width="180" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:CheatRow">
                                                    <TextBlock Text="{Binding AddressText}" Classes="mono" Margin="10,0,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               Classes.unresolved="{Binding !IsResolved}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Route" Width="90" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:CheatRow">
                                                    <TextBlock Text="{Binding RouteText}" Margin="10,0,0,0"
                                                               Foreground="{StaticResource SuccessBrush}"
                                                               ToolTip.Tip="When this route was last seen to still reach a value"
                                                               Classes.unchecked="{Binding RouteText, Converter={x:Static inf:EqualsConverter.Instance}, ConverterParameter='not checked'}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Stored as" Width="150" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate x:DataType="vm:CheatRow">
                                                    <TextBlock Text="{Binding TypeLabel}" Margin="10,0,0,0"
                                                               Foreground="{StaticResource TextFaintBrush}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Value" Width="130" Binding="{Binding ValueText}"
                                                            FontFamily="{StaticResource MonoFont}"
                                                            Foreground="{StaticResource AccentBrush}" x:DataType="vm:CheatRow" />
                                        <DataGridTextColumn Header="Hotkey" Width="110" Binding="{Binding Hotkey}"
                                                            Foreground="{StaticResource TextFaintBrush}" x:DataType="vm:CheatRow" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            IsVisible="{Binding Cheats.Count, Converter={x:Static inf:NotEmpty.Inverted}}">
                                    <TextBlock Text="Nothing saved for this game yet" HorizontalAlignment="Center"
                                               FontSize="12.5" Foreground="{StaticResource TextFaintBrush}" />
                                    <TextBlock Text="Double-click a result to keep it here. Saved cheats come back automatically next time you attach."
                                               HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="11.5" MaxWidth="460"
                                               TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Panel Grid.Row="3" IsVisible="{Binding IsLibraryView}">
                    <views:LibraryView DataContext="{Binding Library}" />
                </Panel>

                <!-- ==================== status ==================== -->
                <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="12,0">
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource TextFaintBrush}" Text="{Binding VersionText}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <views:ResizeGrips />
    </Panel>
</Window>
