<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cheatmaster.App.ViewModels"
        xmlns:inf="using:Cheatmaster.App.Infrastructure"
        xmlns:views="using:Cheatmaster.App.Views"
        x:Class="Cheatmaster.App.Views.MemoryViewWindow"
        x:DataType="vm:MemoryViewModel"
        Title="Memory"
        Icon="/Assets/logo.png"
        Height="620" Width="900" MinHeight="480" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ShowInTaskbar="False">

    <Panel>
        <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
            <Grid RowDefinitions="34,Auto,*,Auto">
                <Grid Name="TitleBar" Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                    <TextBlock Text="Memory" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="12" />
                    <Button Classes="caption close" HorizontalAlignment="Right" Click="OnClose" ToolTip.Tip="Close">
                        <Path Classes="glyph" Data="{StaticResource IconClose}" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="20,16,20,0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <TextBox Name="AddressBox" Width="220" Padding="8,6" VerticalAlignment="Center" Classes="mono"
                                 Text="{Binding AddressInput}" KeyDown="OnAddressKeyDown"
                                 ToolTip.Tip="A hex address, or a module and an offset such as game.exe+1A2B" />
                        <Button Content="Go" Command="{Binding GoCommand}" MinWidth="54" />
                        <Button Content="Back" Command="{Binding BackCommand}" MinWidth="60" />
                        <Button Content="Follow pointer" Command="{Binding FollowCommand}"
                                ToolTip.Tip="Jump to wherever the bytes under the cursor point" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <CheckBox Content="Keep reading" IsChecked="{Binding Live}" VerticalAlignment="Center"
                                  Margin="0,0,12,0" ToolTip.Tip="Re-read twice a second and mark the bytes that moved" />
                        <Button Classes="icon" Command="{Binding PageUpCommand}" ToolTip.Tip="Back one page">
                            <Path Classes="glyph" Data="{StaticResource IconUp}" />
                        </Button>
                        <Button Classes="icon" Command="{Binding PageDownCommand}" ToolTip.Tip="On one page">
                            <Path Classes="glyph" Data="{StaticResource IconDown}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="20,14,20,0" ColumnDefinitions="*,14,280">
                    <Border Grid.Column="0" Classes="card" ClipToBounds="True" MinWidth="420">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10,8">
                            <ItemsControl ItemsSource="{Binding Lines}" PointerReleased="OnCellClicked">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MemoryLine">
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <TextBlock Text="{Binding AddressText}" Width="110" FontSize="11.5"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextFaintBrush}" />
                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MemoryCell">
                                                        <Border Padding="3,1" Margin="1,0" CornerRadius="2" Background="Transparent"
                                                                Classes="cell" Classes.selected="{Binding IsSelected}">
                                                            <TextBlock Text="{Binding Text}" FontSize="11.5"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       Classes="byte" Classes.changed="{Binding Changed}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Ascii}" Margin="12,0,0,0" FontSize="11.5"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextFaintBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Classes="card" Padding="12,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="UNDER THE CURSOR" Classes="section" />
                                <TextBlock Text="{Binding SelectedAddressText}" Margin="0,6,0,0" FontSize="13"
                                           FontFamily="{StaticResource MonoFont}" />
                                <ItemsControl ItemsSource="{Binding Fields}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MemoryField">
                                            <Grid Margin="0,0,0,7" ColumnDefinitions="58,*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11"
                                                           VerticalAlignment="Center" Foreground="{StaticResource TextFaintBrush}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Value}" FontSize="12"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextFaintBrush}"
                                                               IsVisible="{Binding Detail, Converter={x:Static inf:NotEmpty.Instance}}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="Add" Click="OnAddField" Tag="{Binding}"
                                                        Padding="8,2" MinHeight="22" FontSize="11" VerticalAlignment="Center"
                                                        IsEnabled="{Binding IsReadable}"
                                                        ToolTip.Tip="Add this field to the cheat table" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11" LineHeight="17"
                                           Foreground="{StaticResource TextFaintBrush}"
                                           Text="Bytes that moved since the last read are picked out. Play the game with this open and the fields of the object show themselves." />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0" Padding="16,12" Margin="0,14,0,0">
                    <Grid>
                        <TextBlock VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Margin="0,0,16,0" Foreground="{StaticResource TextFaintBrush}">
                            <Run Text="{Binding Description, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding Status, Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="Close" Click="OnClose" MinWidth="100" HorizontalAlignment="Right"
                                Classes="primary" IsCancel="True" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <views:ResizeGrips />
    </Panel>
</Window>
