<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mem="using:Cheatmaster.Core.Memory"
        xmlns:inf="using:Cheatmaster.App.Infrastructure"
        xmlns:views="using:Cheatmaster.App.Views"
        x:Class="Cheatmaster.App.Views.ProcessPickerWindow"
        Title="Choose a process"
        Icon="/Assets/logo.png"
        Height="620" Width="700" MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ShowInTaskbar="False">

    <Panel>
        <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
            <Grid RowDefinitions="34,Auto,*,Auto">
                <Grid Name="TitleBar" Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                    <TextBlock Text="Choose a process" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="12" />
                    <Button Classes="caption close" HorizontalAlignment="Right" Click="OnCancel" ToolTip.Tip="Close">
                        <Path Classes="glyph" Data="{StaticResource IconClose}" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="14,12,14,8" ColumnDefinitions="*,Auto,Auto">
                    <TextBox Name="SearchBox" Grid.Column="0" PlaceholderText="filter by name or window title"
                             TextChanged="OnSearchChanged" />
                    <CheckBox Name="ShowAllBox" Grid.Column="1" Content="Show everything" Margin="12,0,0,0"
                              VerticalAlignment="Center" Click="OnRefresh"
                              ToolTip.Tip="Include system and background processes" />
                    <Button Grid.Column="2" Content="Refresh" Margin="10,0,0,0" Click="OnRefresh" />
                </Grid>

                <ListBox Name="ProcessListBox" Grid.Row="2" Margin="8,0,8,0"
                         DoubleTapped="OnListDoubleClick" SelectionChanged="OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="mem:ProcessCandidate">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                                        <Border Background="#1FE8A33D" BorderBrush="{StaticResource AccentBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="6,0" Margin="8,0,0,0"
                                                VerticalAlignment="Center" IsVisible="{Binding LooksLikeGame}">
                                            <TextBlock Text="likely" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Title, Converter={x:Static inf:NotEmpty.Instance}}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource TextFaintBrush}"
                                           Text="{Binding Pid, StringFormat='pid {0}'}" />

                                <TextBlock Grid.Column="2" VerticalAlignment="Center" MinWidth="70"
                                           TextAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding WorkingSetBytes, Converter={x:Static inf:ByteSize.Instance}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0" Padding="14,10">
                    <Grid>
                        <TextBlock Name="CountLabel" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource TextFaintBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Cancel" Click="OnCancel" MinWidth="90" IsCancel="True" />
                            <Button Name="AttachButton" Content="Attach" Click="OnAttach" MinWidth="110"
                                    Classes="primary" IsDefault="True" IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <views:ResizeGrips />
    </Panel>
</Window>
