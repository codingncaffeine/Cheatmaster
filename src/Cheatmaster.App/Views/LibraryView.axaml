<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cheatmaster.App.ViewModels"
             xmlns:inf="using:Cheatmaster.App.Infrastructure"
             x:Class="Cheatmaster.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid RowDefinitions="Auto,*">
        <!-- toolbar -->
        <Grid Grid.Row="0" Margin="14,14,14,10" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBox Width="280" PlaceholderText="search your saved games" Text="{Binding SearchText}" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="14,0,0,0"
                           FontSize="11.5" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Find artwork" Command="{Binding FetchArtCommand}"
                        ToolTip.Tip="Look up covers and descriptions for every saved game" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Cloud backup" Click="OnCloudBackup"
                        ToolTip.Tip="Back your library up to a private GitHub repository" />
            </StackPanel>
        </Grid>

        <!-- body -->
        <Grid Grid.Row="1" Margin="14,0,14,14" ColumnDefinitions="*,5,380">
            <!-- game grid -->
            <Border Grid.Column="0" Classes="card" ClipToBounds="True" MinWidth="360">
                <Grid>
                    <ListBox Name="GameList" Classes="games" ItemsSource="{Binding Games}"
                             SelectedItem="{Binding Selected}" Margin="8" DoubleTapped="OnGameDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LibraryGameRow">
                                <StackPanel Width="148">
                                    <Grid Height="222">
                                        <Border CornerRadius="5" Background="{StaticResource SurfaceRaisedBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />

                                        <TextBlock Text="{Binding Initials}" FontSize="42" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextFaintBrush}" IsVisible="{Binding !HasCover}" />

                                        <Border CornerRadius="5" ClipToBounds="True">
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                                        </Border>

                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                Margin="6" CornerRadius="9" Padding="7,2" Background="#CC17181B">
                                            <TextBlock Text="{Binding CheatSummary}" FontSize="10.5"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding Name}" Margin="1,7,1,0" FontSize="12"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Margin="1,2,1,0" FontSize="10.5"
                                               Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                                IsVisible="{Binding IsEmpty}">
                        <TextBlock Text="Your library is empty" HorizontalAlignment="Center" FontSize="14"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource TextFaintBrush}"
                                   Text="Attach to a game on the Scanner tab and add a cheat to its table. It is saved here automatically, with cover art and a description looked up for you." />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

            <!-- detail -->
            <Border Grid.Column="2" Classes="card" ClipToBounds="True" MinWidth="280">
                <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding HasSelection}">
                    <StackPanel Grid.Row="0" Margin="16,16,16,0" DataContext="{Binding Selected}" x:DataType="vm:LibraryGameRow">
                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />

                        <!-- who made it, when, and what kind of game it is -->
                        <TextBlock Text="{Binding MetaLine}" Margin="0,5,0,0" FontSize="11.5"
                                   TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"
                                   IsVisible="{Binding MetaLine, Converter={x:Static inf:NotEmpty.Instance}}" />

                        <TextBlock Text="{Binding Description}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   FontSize="12" LineHeight="18" Foreground="{StaticResource TextMutedBrush}"
                                   MaxHeight="150" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding HasDescription}" />

                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="11.5"
                                   Foreground="{StaticResource TextFaintBrush}"
                                   IsVisible="{Binding !HasDescription}"
                                   Text="No store listing was found for this one. Find artwork tries again, and Set cover lets you pick your own." />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="{Binding ExecutableName}" FontSize="11"
                                       FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextFaintBrush}" />
                            <TextBlock Text="{Binding ModifiedText}" FontSize="11" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextFaintBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="16,14,16,10">
                        <Button Content="Set cover" Command="{Binding SetCoverCommand}" Margin="0,0,6,6"
                                Padding="10,4" MinHeight="26" FontSize="11.5" />
                        <Button Content="Export" Command="{Binding ExportCommand}" Margin="0,0,6,6"
                                Padding="10,4" MinHeight="26" FontSize="11.5" />
                        <Button Content="Show file" Command="{Binding RevealCommand}" Margin="0,0,6,6"
                                Padding="10,4" MinHeight="26" FontSize="11.5" />
                        <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,6,6"
                                Padding="10,4" MinHeight="26" FontSize="11.5" Classes="danger" />
                    </WrapPanel>

                    <Grid Grid.Row="2" Margin="16,0,16,16" RowDefinitions="Auto,*">
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="NOTES" Classes="section" />
                            <TextBox DataContext="{Binding Selected}" x:DataType="vm:LibraryGameRow"
                                     Text="{Binding Notes, UpdateSourceTrigger=LostFocus}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120"
                                     VerticalContentAlignment="Top"
                                     PlaceholderText="how you found these, what still needs work…" Margin="0,0,0,14" />

                            <TextBlock Text="SAVED CHEATS" Classes="section" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LibraryGroupRow">
                                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="5"
                                                Margin="0,0,0,6" BorderThickness="1"
                                                Classes="saved-group" Classes.frozen="{Binding AnyFrozen}">
                                            <StackPanel>
                                                <!-- one line per cheat: name, size, and what it is held at -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <ToggleButton Grid.Column="0" Classes="expander-header"
                                                                  HorizontalContentAlignment="Left" Margin="10,4,0,4"
                                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                  ToolTip.Tip="Show the addresses behind this cheat">
                                                        <StackPanel Margin="2,0,0,0">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Summary}" FontSize="10.5" Margin="0,2,0,0"
                                                                       Foreground="{StaticResource TextFaintBrush}" />
                                                        </StackPanel>
                                                    </ToggleButton>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="0,0,8,0" Spacing="4">
                                                        <Border Background="#1F5FA88E" CornerRadius="8" Padding="7,2"
                                                                Margin="0,0,2,0" VerticalAlignment="Center"
                                                                IsVisible="{Binding HeldValue, Converter={x:Static inf:NotEmpty.Instance}}">
                                                            <TextBlock Text="{Binding HeldValue, StringFormat='held at {0}'}"
                                                                       FontSize="10" Foreground="{StaticResource SuccessBrush}" />
                                                        </Border>

                                                        <Button Content="Find it again" Classes="primary" Padding="9,3" MinHeight="24" FontSize="11"
                                                                IsVisible="{Binding CanFindAgain}"
                                                                ToolTip.Tip="Saved addresses move each time the game starts. With the game running, type the number it shows and Cheatmaster finds this again."
                                                                Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).FindAgainCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="Value…" Padding="9,3" MinHeight="24" FontSize="11"
                                                                ToolTip.Tip="Set the value this cheat is held at, ready for next time"
                                                                Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).SetGroupValueCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="Rename" Padding="9,3" MinHeight="24" FontSize="11"
                                                                Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).RenameGroupCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="Hold" Padding="9,3" MinHeight="24" FontSize="11"
                                                                ToolTip.Tip="Hold or release every address in this cheat"
                                                                Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ReleaseGroupCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- the addresses behind it, only when asked for -->
                                                <ItemsControl ItemsSource="{Binding Items}" Margin="30,0,10,9"
                                                              IsVisible="{Binding IsExpanded}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SavedCheatRow">
                                                            <Grid Margin="0,4,0,0" ColumnDefinitions="*,Auto">
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Address}" FontSize="11"
                                                                               FontFamily="{StaticResource MonoFont}"
                                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                                    <TextBlock Text="{Binding Type}" FontSize="10.5"
                                                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                                                               Foreground="{StaticResource TextFaintBrush}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding FrozenAt}" FontSize="10.5" Margin="0,0,8,0"
                                                                               Foreground="{StaticResource SuccessBrush}" />
                                                                    <TextBlock Text="{Binding Hotkey}" FontSize="10.5"
                                                                               Foreground="{StaticResource TextFaintBrush}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
