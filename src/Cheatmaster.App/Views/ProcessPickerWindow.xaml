<Window x:Class="Cheatmaster.App.Views.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Choose a process"
        Icon="/Assets/cheatmaster.ico"
        Height="620" Width="700" MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        UseLayoutRounding="True"
        WindowStyle="None"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                <TextBlock Text="Choose a process" Margin="14,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnCancel" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="14,12,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Tag="filter by name or window title"
                         TextChanged="OnSearchChanged" />
                <CheckBox x:Name="ShowAllBox" Grid.Column="1" Content="Show everything" Margin="12,0,0,0"
                          VerticalAlignment="Center" Click="OnRefresh"
                          ToolTip="Include system and background processes" />
                <Button Grid.Column="2" Content="Refresh" Margin="10,0,0,0" Click="OnRefresh" />
            </Grid>

            <ListBox x:Name="ProcessListBox" Grid.Row="2" Margin="8,0,8,0"
                     MouseDoubleClick="OnListDoubleClick" SelectionChanged="OnSelectionChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                                    <Border Background="#1FE8A33D" BorderBrush="{StaticResource AccentBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="6,0" Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LooksLikeGame}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="likely" FontSize="10"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextFaintBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       Text="{Binding Pid, StringFormat=pid {0}}" />

                            <TextBlock Grid.Column="2" VerticalAlignment="Center" MinWidth="70"
                                       TextAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding WorkingSetBytes, Converter={StaticResource ByteSize}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="14,10">
                <Grid>
                    <TextBlock x:Name="CountLabel" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource TextFaintBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="OnCancel" Margin="0,0,8,0" MinWidth="90" />
                        <Button x:Name="AttachButton" Content="Attach" Click="OnAttach" MinWidth="110"
                                Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
