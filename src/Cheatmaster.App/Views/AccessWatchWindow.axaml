<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cheatmaster.App.ViewModels"
        xmlns:views="using:Cheatmaster.App.Views"
        x:Class="Cheatmaster.App.Views.AccessWatchWindow"
        x:DataType="vm:AccessWatchViewModel"
        Title="See what touches this"
        Icon="/Assets/logo.png"
        Height="640" Width="820" MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ShowInTaskbar="False">

    <Panel>
        <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
            <Grid RowDefinitions="34,Auto,*,Auto">
                <Grid Name="TitleBar" Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                    <TextBlock Text="See what touches this" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="12" />
                    <Button Classes="caption close" HorizontalAlignment="Right" Click="OnClose" ToolTip.Tip="Close">
                        <Path Classes="glyph" Data="{StaticResource IconClose}" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Margin="20,16,20,0">
                    <TextBlock TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource TextMutedBrush}"
                               Text="A search narrows a value down to a few addresses and then cannot tell you which one the game really uses. This waits for the game's own code to touch the address and reports what did — usually along with the object the value belongs to, which is the hard half of finding an address that still works tomorrow." />

                    <Border Margin="0,14,0,0" Padding="12,10" Classes="card">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Description}" FontSize="12.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding AddressText}" FontSize="11" Margin="0,2,0,0"
                                           FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextFaintBrush}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Margin="14,0" VerticalAlignment="Center"
                                      IsChecked="{Binding WritesOnly}" IsEnabled="{Binding !IsWatching}"
                                      Content="Only when it changes"
                                      ToolTip.Tip="Quieter, and it stops the game far less. Leave it off to also catch the code that reads the value." />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontSize="11" Foreground="{StaticResource TextFaintBrush}" Text="{Binding HitCountText}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2" Margin="20,14,20,0" ColumnDefinitions="*,14,330">
                    <Border Grid.Column="0" Classes="card" ClipToBounds="True" MinWidth="260">
                        <Grid>
                            <ListBox ItemsSource="{Binding Sites}" SelectedItem="{Binding Selected}" Margin="6">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccessSiteRow">
                                        <StackPanel Margin="0,3">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Location}" FontSize="11.5"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="10.5"
                                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextFaintBrush}" />
                                            </Grid>
                                            <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                                <Run Text="{Binding WhatText, Mode=OneWay}" />
                                                <Run Text=" · " Foreground="{StaticResource TextFaintBrush}" />
                                                <Run Text="{Binding BaseText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                                        IsVisible="{Binding FoundNothing}">
                                <TextBlock Text="Nothing yet" HorizontalAlignment="Center" FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{StaticResource TextFaintBrush}"
                                           Text="Start watching, then go and do the thing in the game that changes this value." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Classes="card" Padding="12,10" IsVisible="{Binding HasSelection}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="WHAT IT LOOKS LIKE" Classes="section" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11.5" LineHeight="18"
                                           Foreground="{StaticResource TextMutedBrush}" Text="{Binding BaseExplanation}" />
                                <TextBlock Text="REGISTERS" Classes="section" Margin="0,16,0,0" />
                                <SelectableTextBlock Margin="0,6,0,0" FontSize="10.5" LineHeight="16"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     Foreground="{StaticResource TextFaintBrush}" Text="{Binding RegisterText}" />
                                <TextBlock Text="CODE" Classes="section" Margin="0,16,0,0" />
                                <SelectableTextBlock Margin="0,6,0,0" FontSize="10.5" LineHeight="16" TextWrapping="Wrap"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     Foreground="{StaticResource TextFaintBrush}" Text="{Binding CodeText}"
                                                     ToolTip.Tip="The bar marks where the instruction stopped. It runs before the trap, so it is behind the bar." />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0" Padding="16,12" Margin="0,14,0,0">
                    <Grid>
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsWatching}" />
                            <Button Content="Start watching" Command="{Binding StartCommand}" MinWidth="120"
                                    IsVisible="{Binding !IsWatching}" />
                            <Button Content="Show the object" Click="OnShowObject" MinWidth="130"
                                    IsEnabled="{Binding CanTraceRoute}"
                                    ToolTip.Tip="Look at the bytes of the object this value belongs to" />
                            <Button Content="Trace a route from here" Click="OnTraceRoute" MinWidth="170"
                                    Classes="primary" IsEnabled="{Binding CanTraceRoute}"
                                    ToolTip.Tip="Search for a route to this value, using the offset the instruction just showed us" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <views:ResizeGrips />
    </Panel>
</Window>
