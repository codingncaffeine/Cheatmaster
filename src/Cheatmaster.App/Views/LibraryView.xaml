<UserControl x:Class="Cheatmaster.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}"
             FontFamily="{StaticResource UiFont}"
             FontSize="12.5"
             Foreground="{StaticResource TextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Grid Grid.Row="0" Margin="14,14,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBox Width="280" Tag="search your saved games"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="14,0,0,0"
                           FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Find artwork" Command="{Binding FetchArtCommand}" Margin="0,0,8,0"
                        ToolTip="Look up covers and descriptions for every saved game" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- body -->
        <Grid Grid.Row="1" Margin="14,0,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="380" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- game grid -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" ClipToBounds="True">
                <Grid>
                    <ListBox x:Name="GameList" ItemsSource="{Binding Games}"
                             SelectedItem="{Binding Selected}" Margin="8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="OnGameDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="6" />
                                <Setter Property="Margin" Value="2" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="148">
                                    <Grid Height="222">
                                        <Border CornerRadius="5" Background="{StaticResource SurfaceRaisedBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />

                                        <TextBlock Text="{Binding Initials}" FontSize="42" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextFaintBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCover}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border CornerRadius="5" ClipToBounds="True">
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                Margin="6" CornerRadius="9" Padding="7,2"
                                                Background="#CC17181B">
                                            <TextBlock Text="{Binding CheatSummary}" FontSize="10.5"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding Name}" Margin="1,7,1,0" FontSize="12"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Margin="1,2,1,0" FontSize="10.5"
                                               Foreground="{StaticResource TextFaintBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Your library is empty" HorizontalAlignment="Center" FontSize="14"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource TextFaintBrush}"
                                   Text="Attach to a game on the Scanner tab and add a cheat to its table. It is saved here automatically, with cover art and a description looked up for you." />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" />

            <!-- detail -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" ClipToBounds="True">
                <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,16,16,0">
                        <TextBlock Text="{Binding Selected.Name}" FontSize="17" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Selected.Subtitle}" FontSize="11.5"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding Selected.ReleaseDate}" FontSize="11.5" Margin="10,0,0,0"
                                       Foreground="{StaticResource TextFaintBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Selected.Description}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   FontSize="12" LineHeight="18" Foreground="{StaticResource TextMutedBrush}"
                                   MaxHeight="140" TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding Selected.ExecutableName}" FontSize="11"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource TextFaintBrush}" />
                            <TextBlock Text="{Binding Selected.ModifiedText}" FontSize="11" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextFaintBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="16,14,16,10">
                        <Button Content="Set cover" Command="{Binding SetCoverCommand}" Margin="0,0,6,6"
                                Padding="10,4" MinHeight="26" FontSize="11.5" />
                        <Button Content="Export" Command="{Binding ExportCommand}" Margin="0,0,6,6"
                                Padding="10,4" MinHeight="26" FontSize="11.5" />
                        <Button Content="Show file" Command="{Binding RevealCommand}" Margin="0,0,6,6"
                                Padding="10,4" MinHeight="26" FontSize="11.5" />
                        <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,6,6"
                                Padding="10,4" MinHeight="26" FontSize="11.5"
                                Style="{StaticResource DangerButton}" />
                    </WrapPanel>

                    <Grid Grid.Row="2" Margin="16,0,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="NOTES" Style="{StaticResource SectionLabel}" />
                            <TextBox Text="{Binding Selected.Notes, UpdateSourceTrigger=LostFocus}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                     Tag="how you found these, what still needs work…" Margin="0,0,0,14" />

                            <TextBlock Text="SAVED CHEATS" Style="{StaticResource SectionLabel}" />
                        </StackPanel>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedCheats}">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="4"
                                            Padding="10,7" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Description}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding Address}" FontSize="10.5"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               Foreground="{StaticResource TextFaintBrush}" />
                                                    <TextBlock Text="{Binding Type}" FontSize="10.5" Margin="8,0,0,0"
                                                               Foreground="{StaticResource TextFaintBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Border Background="#1F5FA88E" CornerRadius="8" Padding="6,1"
                                                        Visibility="{Binding IsFrozen, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding FrozenAt, StringFormat=frozen at {0}}"
                                                               FontSize="10" Foreground="{StaticResource SuccessBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding Hotkey}" FontSize="10" Margin="0,3,0,0"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource TextFaintBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
