<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cheatmaster.App.ViewModels"
        xmlns:views="using:Cheatmaster.App.Views"
        x:Class="Cheatmaster.App.Views.CloudSyncWindow"
        x:DataType="vm:CloudSyncViewModel"
        Title="Cloud backup"
        Icon="/Assets/logo.png"
        Height="470" Width="520" MinHeight="420" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ShowInTaskbar="False">

    <Panel>
        <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
            <Grid RowDefinitions="34,*,Auto">
                <Grid Name="TitleBar" Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                    <TextBlock Text="Cloud backup" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="12" />
                    <Button Classes="caption close" HorizontalAlignment="Right" Click="OnClose" ToolTip.Tip="Close">
                        <Path Classes="glyph" Data="{StaticResource IconClose}" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Margin="20,18,20,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,9,0"
                                 Classes="status" Classes.on="{Binding IsSignedIn}" />
                        <TextBlock Text="{Binding AccountLine}" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding LastSyncText}" Margin="18,4,0,0" FontSize="11"
                               Foreground="{StaticResource TextFaintBrush}" />

                    <!-- device code -->
                    <Border Margin="0,18,0,0" Padding="16,14" CornerRadius="6"
                            Background="#1AE8A33D" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                            IsVisible="{Binding IsWaitingForAuthorisation}">
                        <StackPanel>
                            <TextBlock Text="ENTER THIS CODE ON GITHUB" Classes="section" />
                            <SelectableTextBlock Text="{Binding UserCode}" FontSize="30" FontWeight="Bold"
                                                 FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Center"
                                                 Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0" Spacing="8">
                                <Button Content="Copy code" Command="{Binding CopyCodeCommand}" />
                                <Button Content="Open GitHub" Command="{Binding OpenVerificationCommand}" Classes="primary" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- explanation -->
                    <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" LineHeight="19" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Cheatmaster creates one private repository on your account and keeps your cheat tables, covers and notes in it. Sign in on another machine and everything comes back. Nothing is public, and no server sits in the middle." />

                    <Border Margin="0,14,0,0" Padding="12,10" Classes="card" IsVisible="{Binding IsSignedIn}">
                        <StackPanel>
                            <CheckBox Content="Back up automatically when the app starts" IsChecked="{Binding AutoBackup}" />
                            <TextBlock Margin="22,4,0,0" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       Text="{Binding RepositoryName, StringFormat='Backed up to your private {0} repository.'}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding Status}" Margin="0,16,0,0" TextWrapping="Wrap" FontSize="11.5"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0" Padding="16,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Sign out" Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}" />
                            <Button Content="Open on GitHub" Command="{Binding OpenRepositoryCommand}" IsVisible="{Binding IsSignedIn}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
                            <Button Content="Sign in with GitHub" Command="{Binding SignInCommand}" MinWidth="150"
                                    Classes="primary" IsVisible="{Binding !IsSignedIn}" />
                            <Button Content="Back up now" Command="{Binding SyncCommand}" MinWidth="130"
                                    Classes="primary" IsVisible="{Binding IsSignedIn}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <views:ResizeGrips />
    </Panel>
</Window>
