<Window x:Class="Cheatmaster.App.Views.ValuePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Set value"
        Icon="/Assets/cheatmaster.ico"
        SizeToContent="Height" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="12.5"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        WindowStyle="None"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <StackPanel>
            <Grid Background="{StaticResource SurfaceBrush}" Height="34">
                <TextBlock x:Name="TitleLabel" Text="Set value" Margin="14,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnCancel" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="20,18,20,0">
                <TextBlock x:Name="MessageLabel" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{StaticResource TextMutedBrush}" />
                <TextBox x:Name="ValueBox" Style="{StaticResource MonoTextBox}" FontSize="16" Padding="10,8"
                         Margin="0,12,0,0" KeyDown="OnValueKeyDown" />
                <TextBlock x:Name="HintLabel" Margin="1,7,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextFaintBrush}" />
            </StackPanel>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="16,12" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="OnCancel" MinWidth="90" Margin="0,0,8,0" IsCancel="True" />
                    <Button x:Name="AcceptButton" Content="Apply" Click="OnAccept" MinWidth="110"
                            Style="{StaticResource PrimaryButton}" IsDefault="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
