<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Cheatmaster.App.Views.ValuePromptWindow"
        Title="Set value"
        Icon="/Assets/logo.png"
        SizeToContent="Height" Width="420"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ShowInTaskbar="False">

    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <StackPanel>
            <Grid Name="TitleBar" Background="{StaticResource SurfaceBrush}" Height="34">
                <TextBlock Name="TitleLabel" Text="Set value" Margin="14,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="12" />
                <Button Classes="caption close" HorizontalAlignment="Right" Click="OnCancel" ToolTip.Tip="Close">
                    <Path Classes="glyph" Data="{StaticResource IconClose}" />
                </Button>
            </Grid>

            <StackPanel Margin="20,18,20,0">
                <TextBlock Name="MessageLabel" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{StaticResource TextMutedBrush}" />
                <TextBox Name="ValueBox" Classes="mono" FontSize="16" Padding="10,8"
                         Margin="0,12,0,0" KeyDown="OnValueKeyDown" />
                <TextBlock Name="HintLabel" Margin="1,7,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextFaintBrush}" />
            </StackPanel>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="16,12" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Cancel" Click="OnCancel" MinWidth="90" IsCancel="True" />
                    <Button Name="AcceptButton" Content="Apply" Click="OnAccept" MinWidth="110"
                            Classes="primary" IsDefault="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
