<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Cheatmaster.App.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Cheatmaster.App\Cheatmaster.App.csproj" />
    <!-- Started as a process by the tests, so it has to be built next to them. -->
    <ProjectReference Include="..\Cheatmaster.WatchTarget\Cheatmaster.WatchTarget.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Cheatmaster.Core.Tests\WatchTargetProcess.cs" Link="WatchTargetProcess.cs" />
  </ItemGroup>
</Project>
